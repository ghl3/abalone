/target
.idea
.claude

# Python / uv
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Training artifacts (run-specific; reproducible from config)
runs/
checkpoints/
# Exported networks for the browser. Written on each promotion by
# train_loop.py; ~12 MB each and regenerated by any run.
#
# The directory contents are ignored, not the directory itself — a `!` rule
# cannot re-include a file whose parent directory is excluded. MODELS.md is
# tracked because it says which generation `best.onnx` currently is, and a run
# overwrites the weights without touching the prose.
web/public/models/*
!web/public/models/MODELS.md

# Sandbox files
*.tmp
